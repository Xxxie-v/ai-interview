# RDS PostgreSQL. Use the VPC/internal endpoint, not the public endpoint.
POSTGRES_HOST=pgm-example.pg.rds.aliyuncs.com
POSTGRES_PORT=5432
POSTGRES_DB=interview_guide
POSTGRES_USER=interview_app
POSTGRES_PASSWORD=replace_me
# Keep database work short; never hold a connection while waiting for the LLM.
APP_DB_POOL_MAX_SIZE=10
APP_DB_POOL_MIN_IDLE=2
APP_DB_CONNECTION_TIMEOUT_MS=5000
APP_DB_VALIDATION_TIMEOUT_MS=3000
APP_DB_LEAK_DETECTION_MS=20000

# Alibaba Cloud OSS through its S3-compatible API (Hangzhou internal endpoint).
APP_STORAGE_PROVIDER=s3
APP_STORAGE_ENDPOINT=https://s3.oss-cn-hangzhou-internal.aliyuncs.com
APP_STORAGE_ACCESS_KEY=replace_with_ram_access_key_id
APP_STORAGE_SECRET_KEY=replace_with_ram_access_key_secret
APP_STORAGE_BUCKET=interview-guide
APP_STORAGE_REGION=aws-global
APP_STORAGE_PATH_STYLE_ACCESS=false

# Alibaba Cloud Model Studio. One DashScope key handles chat, embeddings, ASR, and TTS.
APP_AI_DEFAULT_PROVIDER=dashscope
APP_AI_DEFAULT_EMBEDDING_PROVIDER=dashscope
AI_BAILIAN_API_KEY=replace_me
AI_MODEL=qwen3.5-flash
# 异步生成“简历 + 岗位”匹配题使用质量更高的模型。
AI_QUESTION_MODEL=qwen3.7-plus
APP_INTERVIEW_QUESTION_GENERATION_PROVIDER=dashscope-question
APP_INTERVIEW_DYNAMIC_FOLLOW_UP_PROVIDER=dashscope
APP_INTERVIEW_DYNAMIC_EVALUATION_TIMEOUT=PT6S
APP_INTERVIEW_DYNAMIC_MAX_FOLLOW_UPS_PER_TOPIC=2
APP_INTERVIEW_DYNAMIC_MAX_TOPIC_DURATION=PT4M
APP_INTERVIEW_DYNAMIC_COVERAGE_THRESHOLD=0.75
APP_INTERVIEW_DYNAMIC_MAX_STAGNANT_ROUNDS=2
APP_INTERVIEW_DYNAMIC_RECENT_QA_LIMIT=2

# Authentication. Replace every value before deployment.
APP_AUTH_ADMIN_USERNAME=admin
APP_AUTH_ADMIN_PASSWORD=replace_me
APP_AUTH_JWT_SECRET=replace_with_at_least_32_random_characters
APP_AUTH_IDENTITY_ENCRYPTION_KEY=replace_with_another_32_character_secret
APP_AI_CONFIG_ENCRYPTION_KEY=replace_with_another_32_character_secret
APP_AI_CONFIG_REQUIRE_ENCRYPTION_KEY=true
APP_AI_ROUTER_ENABLED=true
APP_AI_ROUTER_FOLLOW_UP_BUDGET=PT2S
APP_AI_ROUTER_QUESTION_BUDGET=PT90S
APP_AI_ROUTER_REPORT_BUDGET=PT2M

# Production topology and local ONNX inference.
CORS_ALLOWED_ORIGINS=http://47.99.119.191
APP_INTERVIEW_VISION_ENABLED=true
APP_INTERVIEW_VISION_PROVIDER=onnx
APP_INTERVIEW_VISION_SCRFD_MODEL=/app/models/vision/scrfd_500m_kps.onnx
APP_INTERVIEW_VISION_ARCFACE_MODEL=/app/models/vision/w600k_mbf.onnx
APP_INTERVIEW_VISION_DETECTOR_INPUT_SIZE=640
APP_INTERVIEW_VISION_RECOGNITION_INPUT_SIZE=112
APP_INTERVIEW_VISION_FRAME_INTERVAL=PT5S
APP_INTERVIEW_VISION_SUSPECT_FRAME_INTERVAL=PT1S
APP_INTERVIEW_VISION_CONFIRMATION_FRAMES=3
APP_INTERVIEW_VISION_FACE_MISSING_MIN_DURATION=PT2S
APP_INTERVIEW_VISION_MULTIPLE_FACES_MIN_DURATION=PT1S
APP_INTERVIEW_VISION_OTHER_EVENT_MIN_DURATION=PT1S
APP_INTERVIEW_VISION_RECOVERY_WINDOW=PT2S
APP_INTERVIEW_VIOLATION_SCREEN_SWITCH_THRESHOLD=3
APP_INTERVIEW_VIOLATION_MIN_ANOMALY_COUNT=3
APP_INTERVIEW_VIOLATION_MAX_ANOMALY_COUNT=5
APP_INTERVIEW_VIOLATION_DURATION_THRESHOLD=PT30S
APP_INTERVIEW_VIOLATION_RISK_THRESHOLD=0.6

# Qwen real-time ASR and TTS.
APP_VOICE_ASR_PROVIDER=qwen
APP_VOICE_TTS_PROVIDER=qwen
APP_SMS_PROVIDER=noop
APP_SMS_EXPOSE_CODE=false

# Initial RDS bootstrap. Change ddl-auto to validate after the schema is stable.
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_AI_VECTORSTORE_PGVECTOR_INITIALIZE_SCHEMA=true
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70.0 -Dfile.encoding=UTF-8
