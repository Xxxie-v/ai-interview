# =============================================================================
# AI 视频面试系统 - 生产环境变量模板
# =============================================================================
# 使用方法：
#   1. 搜索所有 CHANGE_ME，并替换成真实值。
#   2. 执行：chmod 600 .env.production
#   3. 使用 docker-compose.prod.yml 启动，它会读取 .env.production。
#
# 安全要求：
#   - 不要把真实 .env.production 提交到 Git。
#   - 不要保留本文件中的 CHANGE_ME 占位值。
#   - 数据库、Redis、MinIO 和 8080 端口不要开放到公网。
# =============================================================================


# =============================================================================
# 一、阿里云 RDS PostgreSQL 和 Redis（必须确认）
# =============================================================================
# 【必须填写】在 RDS 控制台“数据库连接”页面复制内网地址。
# 不要填写 http://、端口或数据库名，也不要使用 ECS 公网 IP。
# 示例：pgm-xxxxxxxx.pg.rds.aliyuncs.com
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
# 【必须填写】上面 RDS 数据库账号对应的密码。
POSTGRES_PASSWORD=

# Docker Compose 部署使用服务名 redis；直接运行 JAR 时通常使用 localhost。
REDIS_HOST=redis
REDIS_PORT=6379

# RDS 首次初始化时先使用 update/true，让 JPA 建业务表并初始化向量表。
# 首次启动成功后，建议改为 validate/false 并重新启动应用。
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_AI_VECTORSTORE_PGVECTOR_INITIALIZE_SCHEMA=true


# =============================================================================
# 二、AI 大模型（必须填写）
# =============================================================================
# 【必须填写】阿里云百炼 DashScope API Key，用于默认 LLM、Embedding 和 Qwen 语音。
AI_BAILIAN_API_KEY=CHANGE_ME_DASHSCOPE_API_KEY
AI_MODEL=qwen3.5-flash

# 可选：其他 OpenAI 兼容 Provider，不使用时留空。
PROVIDER_KIMI_API_KEY=
PROVIDER_KIMI_MODEL=kimi-k2.6
PROVIDER_DEEPSEEK_API_KEY=
PROVIDER_DEEPSEEK_MODEL=deepseek-v4-flash

# SiliconFlow (OpenAI compatible)
PROVIDER_SILICONFLOW_API_KEY=
PROVIDER_SILICONFLOW_MODEL=Qwen/Qwen2.5-72B-Instruct
PROVIDER_SILICONFLOW_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
PROVIDER_GLM_API_KEY=
PROVIDER_GLM_MODEL=glm-5
PROVIDER_LMSTUDIO_API_KEY=

# 【生产建议填写】用于加密运行时保存的 Provider API Key，至少 32 位随机字符串。
APP_AI_CONFIG_ENCRYPTION_KEY=
APP_AI_CONFIG_REQUIRE_ENCRYPTION_KEY=true

# 单实例本地动态路由。Provider 健康状态只保存在当前 JVM 内存中。
APP_AI_ROUTER_ENABLED=true
APP_AI_ROUTER_FOLLOW_UP_BUDGET=PT2S
APP_AI_ROUTER_QUESTION_BUDGET=PT90S
APP_AI_ROUTER_REPORT_BUDGET=PT2M
APP_AI_ROUTER_OPEN_COOLDOWN=PT30S


# =============================================================================
# 三、登录、JWT 和管理员（必须填写）
# =============================================================================
APP_AUTH_ADMIN_USERNAME=admin
# 【必须填写】管理员强密码，禁止使用示例密码或手机号。
APP_AUTH_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# 【必须填写】两个不同的、至少 32 位的随机字符串。
APP_AUTH_JWT_SECRET=
APP_AUTH_IDENTITY_ENCRYPTION_KEY=
APP_AUTH_JWT_ISSUER=interview-guide
APP_AUTH_ACCESS_TOKEN_TTL=PT30M
APP_AUTH_REFRESH_TOKEN_TTL=P14D


# =============================================================================
# 四、公网域名和跨域（必须填写）
# =============================================================================
# 【必须填写】替换为真实 HTTPS 域名；多个域名用英文逗号分隔，不要写 *。
# 示例：https://interview.example.com
CORS_ALLOWED_ORIGINS=https://CHANGE_ME_YOUR_DOMAIN


# =============================================================================
# 五、对象存储（云端必须确认）
# =============================================================================
# 使用 Docker Compose 中的 MinIO 时选择 s3。
APP_STORAGE_PROVIDER=s3
APP_STORAGE_ENDPOINT=
APP_STORAGE_BUCKET=interview-a
APP_STORAGE_REGION=aws-global
APP_STORAGE_PATH_STYLE_ACCESS=true

# 【必须填写】同时修改 docker-compose.yml 中 MinIO 和 createbuckets 的账号密码。
APP_STORAGE_ACCESS_KEY=
APP_STORAGE_SECRET_KEY=

# 如果不使用 MinIO，而使用本地磁盘，可改成 local，并为该目录挂载持久化磁盘。
# APP_STORAGE_PROVIDER=local
# APP_STORAGE_LOCAL_DIR=/app/data/storage


# =============================================================================
# 六、短信验证码（正式手机号登录时必须填写）
# =============================================================================
# 正式环境使用项目已支持的阿里云号码认证 Provider。
APP_SMS_PROVIDER=aliyun-pnvs
APP_SMS_REGION_ID=cn-hangzhou
# 【使用短信登录时必须填写】
APP_SMS_ACCESS_KEY_ID=CHANGE_ME_ALIYUN_SMS_ACCESS_KEY_ID
APP_SMS_ACCESS_KEY_SECRET=CHANGE_ME_ALIYUN_SMS_ACCESS_KEY_SECRET
APP_SMS_SIGN_NAME=CHANGE_ME_SMS_SIGN_NAME
APP_SMS_TEMPLATE_CODE=CHANGE_ME_SMS_TEMPLATE_CODE
APP_SMS_SCHEME_NAME=CHANGE_ME_SMS_SCHEME_NAME
APP_SMS_COUNTRY_CODE=86

APP_SMS_CODE_LENGTH=6
APP_SMS_VALID_TIME=300
APP_SMS_INTERVAL=60
APP_SMS_CODE_TYPE=1
APP_SMS_DUPLICATE_POLICY=1
APP_SMS_CODE_EXPIRATION=PT5M
APP_SMS_RESEND_INTERVAL=PT60S
APP_SMS_MAX_ATTEMPTS=5
APP_SMS_MAX_SENDS_PER_IP=20

# 【生产环境必须为 false】禁止把验证码返回给前端。
APP_SMS_EXPOSE_CODE=false

# 仅本地开发才可以启用以下两项，生产环境禁止使用：
# APP_SMS_PROVIDER=noop
# APP_SMS_NOOP_CODE=123456


# =============================================================================
# 七、微信和 QQ OAuth（不用可以留空）
# =============================================================================
APP_AUTH_WECHAT_CLIENT_ID=
APP_AUTH_WECHAT_CLIENT_SECRET=
APP_AUTH_WECHAT_REDIRECT_URI=https://CHANGE_ME_YOUR_DOMAIN/oauth/callback/wechat

APP_AUTH_QQ_CLIENT_ID=
APP_AUTH_QQ_CLIENT_SECRET=
APP_AUTH_QQ_REDIRECT_URI=https://CHANGE_ME_YOUR_DOMAIN/oauth/callback/qq


# =============================================================================
# 八、ONNX 人脸检测与身份核验（云端必须确认）
# =============================================================================
APP_INTERVIEW_VISION_ENABLED=true
APP_INTERVIEW_VISION_PROVIDER=onnx

# 模型需要手动上传到服务器，并挂载到后端容器的 /app/models/vision。
APP_INTERVIEW_VISION_SCRFD_MODEL=models/vision/
APP_INTERVIEW_VISION_ARCFACE_MODEL=models/vision/
APP_INTERVIEW_VISION_DETECTOR_INPUT_SIZE=640
APP_INTERVIEW_VISION_RECOGNITION_INPUT_SIZE=112
APP_INTERVIEW_VISION_DETECTION_THRESHOLD=0.5
APP_INTERVIEW_VISION_NMS_THRESHOLD=0.4
APP_INTERVIEW_VISION_IDENTITY_THRESHOLD=0.5
APP_INTERVIEW_VISION_REFERENCE_MIN_CONFIDENCE=0.75
APP_INTERVIEW_VISION_REFERENCE_TTL=PT4H
APP_INTERVIEW_VISION_FRAME_INTERVAL=PT5S
APP_INTERVIEW_VISION_SUSPECT_FRAME_INTERVAL=PT1S
APP_INTERVIEW_VISION_CONFIRMATION_FRAMES=3
APP_INTERVIEW_VISION_FACE_MISSING_MIN_DURATION=PT2S
APP_INTERVIEW_VISION_MULTIPLE_FACES_MIN_DURATION=PT1S
APP_INTERVIEW_VISION_OTHER_EVENT_MIN_DURATION=PT1S
APP_INTERVIEW_VISION_RECOVERY_WINDOW=PT2S
APP_INTERVIEW_VISION_EVENT_COOLDOWN=PT30S
APP_INTERVIEW_VISION_LOW_LIGHT_THRESHOLD=40

# 违规结论：切屏为硬规则，其余视觉异常按次数和持续时间计算风险。
APP_INTERVIEW_VIOLATION_SCREEN_SWITCH_THRESHOLD=3
APP_INTERVIEW_VIOLATION_SCREEN_SWITCH_MERGE_WINDOW=PT2S
APP_INTERVIEW_VIOLATION_MIN_ANOMALY_COUNT=3
APP_INTERVIEW_VIOLATION_MAX_ANOMALY_COUNT=5
APP_INTERVIEW_VIOLATION_DURATION_THRESHOLD=PT30S
APP_INTERVIEW_VIOLATION_COUNT_WEIGHT=0.6
APP_INTERVIEW_VIOLATION_DURATION_WEIGHT=0.4
APP_INTERVIEW_VIOLATION_RISK_THRESHOLD=0.6


# =============================================================================
# 九、语音识别和语音合成（正式语音面试建议启用）
# =============================================================================
# qwen 使用上方同一个 AI_BAILIAN_API_KEY；暂不启用时可改成 mock。
APP_VOICE_ASR_PROVIDER=qwen
APP_VOICE_TTS_PROVIDER=qwen
APP_VOICE_ASR_SILENCE_MS=2000
APP_VOICE_USER_UTTERANCE_DEBOUNCE_MS=2500
APP_VOICE_MIN_SILENCE_BEFORE_COMMIT_MS=2500
APP_VOICE_MIN_COMMIT_CHARS=20
APP_VOICE_MAX_WAIT_FOR_CONTINUATION_MS=7000
APP_VOICE_AI_QUESTION_MAX_CHARS=120


# =============================================================================
# 十、面试题、视频和事件参数（默认值可直接使用）
# =============================================================================
APP_INTERVIEW_DYNAMIC_MAX_TOTAL_QUESTIONS=48
APP_INTERVIEW_DYNAMIC_MAX_FOLLOW_UPS_PER_TOPIC=2
APP_INTERVIEW_DYNAMIC_MAX_TOPIC_DURATION=PT4M
APP_INTERVIEW_DYNAMIC_COVERAGE_THRESHOLD=0.75
APP_INTERVIEW_DYNAMIC_MAX_STAGNANT_ROUNDS=2
APP_INTERVIEW_DYNAMIC_RECENT_QA_LIMIT=2
APP_INTERVIEW_QUESTION_GENERATION_PROVIDER=dashscope
APP_INTERVIEW_OFFICIAL_MIN_QUESTIONS_PER_SOURCE=3
APP_INTERVIEW_OFFICIAL_MAX_QUESTIONS_PER_SOURCE=6
APP_INTERVIEW_JOB_FIXED_QUESTION_COUNT=6
APP_INTERVIEW_RESUME_PREPARED_QUESTION_COUNT=6

APP_INTERVIEW_EVENT_RETENTION=PT2H
APP_INTERVIEW_EVENT_MAX_PER_SESSION=200
APP_INTERVIEW_VIDEO_CHUNK_DURATION=PT25S
APP_INTERVIEW_VIDEO_MAX_CHUNK_SIZE=26214400
APP_INTERVIEW_VIDEO_RETENTION_DAYS=30
APP_INTERVIEW_VIDEO_CLEANUP_CRON=0 30 3 * * *


# =============================================================================
# 十一、前端说明
# =============================================================================
# 前后端同域部署时，不需要设置 VITE_WS_BASE_URL，前端会自动使用：
#   https://你的域名  -> wss://你的域名/ws/...
#
# 如果前后端分开部署，VITE_* 必须写入 frontend/.env.production，并在构建前端镜像
# 之前设置；根目录本文件中的 VITE_* 不会自动进入 Vite 构建。
